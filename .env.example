# .env.example
# Add the following keys inside .env

# Resend API Key for sending Newsletter emails
# Get this from https://resend.com/api-keys
RESEND_API_KEY=

# Supabase Keys (required for database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# EmailJS Keys (for Form Subscriptions)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_WELCOME_TEMPLATE_ID=
VITE_EMAILJS_OWNER_TEMPLATE_ID=
